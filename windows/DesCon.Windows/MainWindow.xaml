<Window x:Class="DesCon.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DesCon.Windows.Models"
        xmlns:viewModels="clr-namespace:DesCon.Windows.ViewModels"
        Title="DesCon Settings" Width="940" Height="700" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="Transparent" Icon="Resources/DesCon.ico">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="22,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DesCon" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Display switching" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Margin="18,0,18,0" TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="MinWidth" Value="145" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="13,10" />
                    <Setter Property="Margin" Value="0,0,12,4" />
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </Style>
            </TabControl.Resources>

            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,4,10">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                                    <TextBlock Text="Translucency stays enabled in both Light and Dark modes."
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" SelectionChanged="ThemeChanged" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Startup" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <CheckBox Content="Start DesCon when I sign in to Windows" IsChecked="{Binding LaunchAtLogin}" />
                        </Border>

                        <TextBlock Text="Peer connection" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Mac + Windows over LAN" FontWeight="SemiBold" />
                                <TextBlock Text="Managed profiles use authenticated peer-to-peer LAN commands. External profiles send DDC without waiting for a peer."
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0" />
                                <CheckBox Content="Enable LAN peer" IsChecked="{Binding NetworkEnabled}" Margin="0,14,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="Device name" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Pairing key" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SharedKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                </Grid>
                                <TextBlock Text="Use the exact same key on the Mac. At least 8 characters. Commands stay inside the LAN."
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="120,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Monitors">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,4,10">
                    <StackPanel>
                        <TextBlock Text="Monitors" Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding Monitors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:MonitorEditorViewModel}">
                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Source" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="2" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" TextAlignment="Center" IsReadOnly="{Binding IsLocked}" />
                                            <TextBlock Grid.Column="3" Text="VCP" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <TextBox Grid.Column="4" Text="{Binding Vcp, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" TextAlignment="Center" IsReadOnly="{Binding IsLocked}" />
                                            <Button Grid.Column="5" Content="{Binding LockGlyph}" FontFamily="Segoe Fluent Icons" Padding="0" Margin="8,0,0,0"
                                                    Background="Transparent" BorderThickness="0" Click="LockMonitorClicked" ToolTip="Unlock or lock DDC fields" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Unlock a monitor to edit Source/VCP; changes take effect only after Save. Source is the DDC packet source address, not a monitor input. LG DDC2AB: Source 50 · VCP F4 · HDMI 1 0090 · HDMI 2 0091 · DisplayPort 00D0."
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="3,2,3,8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Switching Profiles">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,4,10">
                    <StackPanel>
                        <DockPanel Margin="2,6,0,10">
                            <TextBlock Text="Switching Profiles" Style="{StaticResource SectionTitleStyle}" Margin="0" DockPanel.Dock="Left" />
                            <Button Content="＋  Add Profile" Click="AddProfileClicked" DockPanel.Dock="Right" Padding="10,5" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ProfileEditorViewModel}">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="{Binding FavoriteGlyph}" FontSize="17" Padding="0" Background="Transparent" BorderThickness="0"
                                                        Click="FavoriteClicked" ToolTip="Make favorite" />
                                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
                                                <TextBox Grid.Column="2" Text="{Binding HotKeyText}" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown"
                                                         HorizontalContentAlignment="Center" ToolTip="Click and press a shortcut. Backspace clears it." />
                                                <Button Grid.Column="3" Content="" FontFamily="Segoe Fluent Icons" Padding="0" Margin="8,0,0,0"
                                                        Background="Transparent" BorderThickness="0" Click="DeleteProfileClicked" ToolTip="Delete profile" />
                                            </Grid>

                                            <Grid Margin="34,9,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding CoordinationModes}" SelectedItem="{Binding CoordinationMode}" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding ManagedTargets}" SelectedItem="{Binding ManagedTarget}" Margin="8,0,0,0">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsExternal}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <TextBox Grid.Column="1" Text="{Binding ExternalTargetName, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsExternal}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Monitors}" Margin="34,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewModels:ProfileMonitorRowViewModel}">
                                                        <Grid Margin="0,5,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24" /><ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="44" /><ColumnDefinition Width="66" />
                                                                <ColumnDefinition Width="120" /><ColumnDefinition Width="130" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsIncluded}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                                                            <TextBlock Grid.Column="2" Text="Input" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="11" />
                                                            <TextBox Grid.Column="3" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" TextAlignment="Center" Padding="5,3" />
                                                            <ComboBox Grid.Column="4" ItemsSource="{Binding MacBehaviors}" SelectedItem="{Binding MacBehavior}" Margin="8,0,0,0" Padding="5,2" ToolTip="macOS display behavior" />
                                                            <ComboBox Grid.Column="5" ItemsSource="{Binding Behaviors}" SelectedItem="{Binding Behavior}" Margin="8,0,0,0" Padding="5,2" ToolTip="Windows display behavior" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="22,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Save Settings" Click="SaveClicked" MinWidth="118" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
