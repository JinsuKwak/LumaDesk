<Window x:Class="DesCon.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DesCon.Windows.Models"
        xmlns:viewModels="clr-namespace:DesCon.Windows.ViewModels"
        Title="LumaDesk Settings" Width="1040" Height="760" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Icon="Resources/DesCon.ico">
    <Grid Background="Transparent" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,11,0">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LumaDesk" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Display switching" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="11,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                               MaxWidth="310" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource NavigationTabControlStyle}" TabStripPlacement="Left">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14" Width="25" />
                        <TextBlock Text="General" FontWeight="SemiBold" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,22,24">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Appearance, startup, and peer connection settings."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18" />

                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                                    <TextBlock Text="Follow Windows or choose a fixed appearance. Mica remains enabled."
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,16,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" SelectionChanged="ThemeChanged" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Startup" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <CheckBox Content="Start LumaDesk when I sign in to Windows" IsChecked="{Binding LaunchAtLogin}" />
                        </Border>

                        <TextBlock Text="Peer connection" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Mac + Windows over LAN" FontWeight="SemiBold" />
                                        <TextBlock Text="Managed profiles coordinate both computers directly. No server or cloud connection is used."
                                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,18,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding NetworkEnabled}" VerticalAlignment="Center" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,15,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Device name" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Text="Pairing key" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Top" Margin="0,17,0,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SharedKey, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSharedKeyValid}" Value="False">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Grid.Column="1" Content="Save" Click="SavePeerKeyClicked" Margin="8,0,0,0" MinWidth="72">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSharedKeyValid}" Value="True" />
                                                                    <Condition Binding="{Binding IsSharedKeyDirty}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="IsEnabled" Value="True" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="Use 8 or more characters" Foreground="{DynamicResource DangerBrush}" FontSize="10" Margin="2,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSharedKeyValid}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,15,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Rollback on missing confirmation" FontWeight="SemiBold" />
                                        <TextBlock Text="Restore the last successfully applied profile if the peer does not confirm the switch."
                                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,18,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Content="Enabled" IsChecked="{Binding RollbackOnPeerFailure}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <ComboBox Width="54" ItemsSource="{Binding ConfirmationTimeoutOptions}"
                                                  SelectedItem="{Binding ConfirmationTimeoutSeconds}" IsEnabled="{Binding RollbackOnPeerFailure}" />
                                        <TextBlock Text="sec" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,15,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Peers are searched at launch, on demand, or manually. No periodic broadcast runs in the background."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Rescan LAN" Click="RescanPeerClicked" IsEnabled="{Binding NetworkEnabled}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="14" Width="25" />
                        <TextBlock Text="Monitors" FontWeight="SemiBold" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,22,24">
                    <StackPanel>
                        <TextBlock Text="Monitors" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="DDC transport and physical monitor identities. Unlock a row to edit it."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18" />

                        <ItemsControl ItemsSource="{Binding Monitors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:MonitorEditorViewModel}">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="38" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="Source" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="11" />
                                                <TextBox Grid.Column="2" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" TextAlignment="Center"
                                                         IsReadOnly="{Binding IsLocked}" Padding="4,1" MinHeight="25" />
                                                <TextBlock Grid.Column="3" Text="VCP" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" />
                                                <TextBox Grid.Column="4" Text="{Binding Vcp, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" TextAlignment="Center"
                                                         IsReadOnly="{Binding IsLocked}" Padding="4,1" MinHeight="25" />
                                                <Button Grid.Column="5" Content="{Binding LockGlyph}" FontFamily="Segoe Fluent Icons" Style="{StaticResource IconButtonStyle}"
                                                        Margin="7,0,0,0" Click="LockMonitorClicked" ToolTip="Unlock monitor settings" />
                                            </Grid>

                                            <Grid Margin="0,14,38,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLocked}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Pairing ID" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding PairingId, UpdateSourceTrigger=PropertyChanged}" Padding="8,2" MinHeight="26"
                                                         ToolTip="Use the same Pairing ID for this physical monitor on Mac and Windows." />
                                                <TextBlock Grid.Column="2" Text="Same on Mac and Windows" Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource CardStyle}" Background="{DynamicResource AccentSoftBrush}">
                            <StackPanel>
                                <TextBlock Text="LG DDC2AB reference" FontWeight="SemiBold" />
                                <TextBlock Text="Source 50 · VCP F4 · HDMI 1 0090 · HDMI 2 0091 · DisplayPort 00D0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,5,0,0" />
                                <TextBlock Text="Source is the DDC packet address, not a monitor input. Values are hexadecimal without 0x."
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="14" Width="25" />
                        <TextBlock Text="Profiles" FontWeight="SemiBold" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,22,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Switching Profiles" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Choose monitor inputs and each computer's display behavior."
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="＋  Add Profile" Click="AddProfileClicked" VerticalAlignment="Center" Padding="10,4" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ProfileEditorViewModel}">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="145" />
                                                    <ColumnDefinition Width="38" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="{Binding FavoriteGlyph}" FontSize="16" Style="{StaticResource IconButtonStyle}"
                                                        Click="FavoriteClicked" ToolTip="Make favorite" />
                                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="2,0,12,0"
                                                         Padding="8,2" MinHeight="26" />
                                                <TextBox Grid.Column="2" Text="{Binding HotKeyText}" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown"
                                                         GotKeyboardFocus="ShortcutRecordingStarted" LostKeyboardFocus="ShortcutRecordingEnded"
                                                         HorizontalContentAlignment="Center" ToolTip="Click and press a shortcut. Backspace clears it."
                                                         Padding="8,2" MinHeight="26" />
                                                <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Style="{StaticResource IconButtonStyle}"
                                                        Margin="7,0,0,0" Click="DeleteProfileClicked" ToolTip="Delete profile" />
                                            </Grid>

                                            <Grid Margin="38,8,0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding CoordinationModes}" SelectedItem="{Binding CoordinationMode}"
                                                          Padding="6,2" MinHeight="26">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding}" Value="{x:Static models:ProfileCoordinationMode.Managed}">
                                                                                <Setter Property="Text" Value="Mac + Windows" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="{x:Static models:ProfileCoordinationMode.Self}">
                                                                                <Setter Property="Text" Value="This Device" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="{x:Static models:ProfileCoordinationMode.Restore}">
                                                                                <Setter Property="Text" Value="Restore Layout" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="{x:Static models:ProfileCoordinationMode.External}">
                                                                                <Setter Property="Text" Value="External device" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DirectionLabel}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="38,0,0,8">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrimaryMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="145" />
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="145" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Primary" VerticalAlignment="Center" Margin="0,0,7,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding PrimaryMonitorOptions}"
                                                          SelectedItem="{Binding ActivePrimaryMonitor}" DisplayMemberPath="Label"
                                                          Padding="6,1" MinHeight="25" />
                                                <StackPanel Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowPeerPrimary}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Peer fallback" VerticalAlignment="Center" Margin="0,0,7,0"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                                    <ComboBox Width="145" ItemsSource="{Binding PrimaryMonitorOptions}"
                                                              SelectedItem="{Binding PeerPrimaryMonitor}" DisplayMemberPath="Label"
                                                              Padding="6,1" MinHeight="25" />
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Monitors}" Margin="38,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewModels:ProfileMonitorRowViewModel}">
                                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,2">
                                                            <Grid>
                                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="24" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="42" />
                                                                    <ColumnDefinition Width="66" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                                                                <TextBlock Grid.Column="2" Text="Input" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowInputControls}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBox Grid.Column="3" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" TextAlignment="Center"
                                                                         Padding="4,1" MinHeight="25">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowInputControls}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>

                                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                                                                            HorizontalAlignment="Right" Margin="0,5,0,0">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowBehaviorControls}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="Behavior" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="10" Margin="0,0,10,0" />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ShowMacBehavior}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <TextBlock Text="Mac" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="10" Margin="0,0,5,0" />
                                                                        <ComboBox Width="124" ItemsSource="{Binding MacBehaviors}" SelectedItem="{Binding MacBehavior}" Padding="4,1" MinHeight="25" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="Windows" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="10" Margin="10,0,5,0" />
                                                                    <ComboBox Width="134" ItemsSource="{Binding Behaviors}" SelectedItem="{Binding Behavior}" Padding="4,1" MinHeight="25" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="4,10,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Changes to monitors and profiles are applied only after saving."
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Save Settings" Click="SaveClicked" MinWidth="124" Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
